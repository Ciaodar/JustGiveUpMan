<?xml version="1.0" encoding="utf-8"?>
<base xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" type="string">
  <tags>
    <tag language="简体中文"/>
  </tags>
  <strings>
    <string id="jgum_test_msg" text="“放弃吧，伙计”模组加载成功！"/>
    <string id="jgum_siege_surrender_offer_count" text="3"/>
    <string id="jgum_siege_surrender_accept_count" text="2"/>
    <string id="jgum_siege_surrender_reject_count" text="2"/>
    <string id="jgum_field_surrender_offer_count" text="1"/>
    <string id="jgum_field_surrender_accept_count" text="1"/>
    <string id="jgum_field_surrender_reject_count" text="1"/>
    <string id="jgum_siege_defender_greeting" text="感谢您同意这次和谈，{?PLAYER.GENDER}女士{?}先生{\?}.[ib:normal][if:convo_calm_friendly]"/>
    <string id="jgum_siege_player_siege_surrender_offer" text="你的处境已无希望。立即投降，让你的子民免遭最后强攻的恐怖。"/>
    <string id="jgum_siege_surrender_offer_1" text="我们的粮仓空空如也，士兵们形同鬼魅。这座城市归你了。[ib:nervous][if:convo_sad]"/>
    <string id="jgum_siege_surrender_offer_2" text="我们无法再坚守这些城墙一天。我们将自己托付于你的仁慈；这座城堡归你了。[ib:powerless][if:convo_pleading]"/>
    <string id="jgum_siege_surrender_offer_3" text="士兵们因饥饿而濒临疯狂。我们投降。[ib:weary][if:convo_exhausted]"/>
    <string id="jgum_siege_defender_accepted" text="你的大名将因这仁慈之举而受到赞誉！[ib:rejoice][if:convo_joyful]"/>
    <string id="jgum_siege_surrender_accept_1" text="作为将你从饥饿之口中拯救出来的人，我赐予你这宽恕。"/>
    <string id="jgum_siege_surrender_accept_2" text="明智的选择。放下武器，你便能活到看见下一个黎明。"/>
    <string id="jgum_siege_defender_rejected" text="那就让历史的年鉴记住这暴行吧！[ib:aggressive][if:convo_furious]"/>
    <string id="jgum_siege_surrender_reject_1" text="让我们看看你在空腹和祈祷下能打得有多好。"/>
    <string id="jgum_siege_surrender_reject_2" text="现在乞求为时已晚。我要来将你的堡垒碾为尘土。"/>
    <string id="jgum_field_surrender_offer_1" text="住手！我们寡不敌众！我们投降！[ib:powerless][if:convo_pleading]"/>
    <string id="jgum_field_surrender_accept_1" text="我们接受你的投降。把武器扔在地上！"/>
    <string id="jgum_field_surrender_reject_1" text="对懦夫绝不宽恕。准备受死！"/>
    <string id="jgum_field_surrender_end" text="明智的选择。今日你将免于一死。[if:convo_calm_friendly]"/>
    <string id="jgum_field_surrender_success" text="敌人已丧失战斗意志并投降！"/>
    <string id="jgum_field_surrender_rejected" text="钢铁的碰撞仍将继续！"/>
    <string id="jgum_siege_surrender_notification_town" text="{SETTLEMENT_NAME}的指挥官派出一名打着白旗的骑手。他们希望商讨投降条款。"/>
    <string id="jgum_siege_surrender_notification_castle" text="{SETTLEMENT_NAME}的城堡守备官希望议和投降。"/>
    <string id="jgum_siege_inquiry_title" text="议和请求"/>
    <string id="jgum_siege_inquiry_accept" text="接见使者"/>
    <string id="jgum_siege_inquiry_reject" text="遣返骑手"/>
    <string id="jgum_siege_assault_triggered" text="绝望打破了僵局！守军发起冲锋！"/>
    <string id="jgum_siege_starvation_sally_out" text="守军饥肠辘辘，发动了一次绝望的突围！"/>
    <string id="jgum_siege_negotiation_menu_option" text="提议议和以避免进一步的流血。"/>
    <string id="jgum_siege_negotiation_menu_tooltip_pending" text="您的使者尚未归来。请耐心等候，{?PLAYER.GENDER}女士{?}先生{\?}。"/>
    <string id="jgum_siege_negotiation_menu_tooltip_cooldown" text="您的信使需要休息，{?PLAYER.GENDER}女士{?}先生{\?}。请稍作等待。"/>
    <string id="jgum_siege_negotiation_menu_tooltip_retry" text="在上一次失败后不久，他们不会愿意再接待您的另一位信使。"/>
    <string id="jgum_siege_negotiation_request_sent" text="您的骑手打着休战旗传递条款。我们等待他们的回复。"/>
    <string id="jgum_siege_negotiation_inquiry_title" text="渡鸦抵达"/>
    <string id="jgum_siege_negotiation_inquiry_accepted" text="一份洁净的卷轴送达，上面盖着守军的印章。他们愿与您会面。"/>
    <string id="jgum_siege_negotiation_inquiry_rejected" text="传回的消息沾满泥泞。守军对您的条款嗤之以鼻，认为他们的城墙比您的意志更坚固。"/>
    <string id="jgum_siege_negotiation_inquiry_go" text="参加议和"/>
    <string id="jgum_siege_negotiation_inquiry_ok" text="就这样吧。"/>
    <string id="jgum_proactive_intro" text="我们在听。陈述你的来意。[ib:nervous][if:convo_grave]"/>
    <string id="jgum_proactive_player_open" text="这场流血毫无必要。让我们理性交谈。"/>
    <string id="jgum_proactive_task_line" text="这些城墙以及城内百姓的命运，全系于你接下来的言辞。[if:convo_calm_hostile]"/>
    <string id="jgum_proactive_task_fail_immediate" text="苍白无力的说辞。[if:convo_unimpressed]"/>
    <string id="jgum_proactive_task_fail_final" text="你的话不过是空谈。我们绝不屈服。[if:convo_furious]"/>
    <string id="jgum_proactive_option_t1_1" text="别让你的子民去为一场注定失败的防御战送死。"/>
    <string id="jgum_proactive_option_t1_2" text="傻子都看得清兵力对比。这场围城战只有一个结局。"/>
    <string id="jgum_proactive_option_t1_3" text="选择荣誉之路吧。让你的子民免于这悲惨的命运。"/>
    <string id="jgum_proactive_option_t2_1" text="你的城墙正在崩塌。每拖延一刻，就会有更多的人丧命。"/>
    <string id="jgum_proactive_option_t2_2" text="一旦我的士兵攻破城墙，你就没有任何谈判的筹码了。"/>
    <string id="jgum_proactive_option_t2_3" text="打开城门，我会确保平民秩序井然。"/>
    <string id="jgum_proactive_option_t3_1" text="通过条约投降是一种荣誉之举，将为整个卡拉迪亚所铭记。"/>
    <string id="jgum_proactive_option_t3_2" text="每过一小时，你的补给就在减少，而我的大军却在壮大。"/>
    <string id="jgum_proactive_option_t3_3" text="别让骄傲成为你子民的墓碑。仁慈地结束这一切吧。"/>
    <string id="jgum_proactive_option_t4_1" text="城市的根本在于人民，而非砖石。保全他们吧。"/>
    <string id="jgum_proactive_option_t4_2" text="现在投降，明日市场仍将交易货物；若是抵抗，市场上将只剩灰烬。"/>
    <string id="jgum_proactive_option_t4_3" text="选择投降，让历史铭记你的克制，而非你的毁灭。"/>
    <string id="jgum_proactive_option_locked_used" text="你已经提出过这个请求了。这招不会再管用。"/>
    <string id="jgum_proactive_option_locked_mercy" text="鉴于你过去的所作所为，任何求饶之词听起来都显得空洞。"/>
    <string id="jgum_proactive_option_locked_honor" text="像你这样……名声的人，没资格谈论荣誉。"/>
    <string id="jgum_proactive_option_locked_calculating" text="你的狡诈之名还不足以支撑这种论调。"/>
    <string id="jgum_proactive_option_locked_walls" text="他们的城墙尚未被破。这种说法毫无分量。"/>
    <string id="jgum_proactive_success" text="你说得有理。今日不必再多造杀孽。[if:convo_calm_friendly]"/>
    <string id="jgum_proactive_fail" text="够了！我们绝不投降。[if:convo_furious]"/>
    <string id="jgum_proactive_continue" text="你的观点……已记录。继续。[if:convo_thinking]"/>
    <string id="JGUM.Settings.DisplayName" text="劝降者"/>
    <string id="JGUM.Settings.Group.Common" text="普通"/>
    <string id="JGUM.Settings.Group.Siege" text="攻城"/>
    <string id="JGUM.Settings.Group.Lord" text="领主"/>
    <string id="JGUM.Settings.Group.Patrol" text="巡逻"/>
    <string id="JGUM.Settings.Group.Advanced" text="高级"/>
    <string id="JGUM.Settings.SurrenderTendencyMultiplier.Name" text="总体投降倾向"/>
    <string id="JGUM.Settings.SurrenderTendencyMultiplier.Hint" text="控制敌人整体的投降意愿。数值越高，敌人越容易投降；数值越低，抵抗越久。默认值：1.0"/>
    <string id="JGUM.Settings.BaseSurrenderThreshold.Name" text="基础投降阈值"/>
    <string id="JGUM.Settings.BaseSurrenderThreshold.Hint" text="敌人考虑投降所需的最小兵力优势。数值越高，意味着你需要拥有更大的优势。默认值：3.5"/>
    <string id="JGUM.Settings.SurrenderRandomnessMode.Name" text="投降随机模式"/>
    <string id="JGUM.Settings.SurrenderRandomnessMode.Hint" text="决定随机数如何应用于投降计算。关闭：完全基于阈值。阈值内：随机数应用于基础阈值与保证阈值之间。无限制：始终应用少量随机数。"/>
    <string id="JGUM.Settings.SurrenderRandomnessMode.Off" text="关闭"/>
    <string id="JGUM.Settings.SurrenderRandomnessMode.Thresholded" text="阈值内"/>
    <string id="JGUM.Settings.SurrenderRandomnessMode.Unbound" text="无限制"/>
    <string id="JGUM.Settings.GuaranteedSurrenderThreshold.Name" text="保证投降阈值"/>
    <string id="JGUM.Settings.GuaranteedSurrenderThreshold.Hint" text="无需随机数即可保证投降所需的兵力优势（用于“阈值内”和“无限制”模式）。默认值：5.0"/>
    <string id="JGUM.Settings.PlayerMercyMultiplier.Name" text="玩家仁慈系数"/>
    <string id="JGUM.Settings.PlayerMercyMultiplier.Hint" text="角色的“仁慈”特质对投降几率的影响程度。仁慈的声誉会使敌人更愿意投降；残酷的声誉则会使他们抵抗更顽强。默认值：100"/>
    <string id="JGUM.Settings.RequiredSurrenderCount.Name" text="所需投降次数"/>
    <string id="JGUM.Settings.RequiredSurrenderCount.Hint" text="AI领主需要投降多少次才能获得一点“仁慈”特质。默认值：3"/>
    <string id="JGUM.Settings.EnableSiegeSurrender.Name" text="启用围城投降"/>
    <string id="JGUM.Settings.EnableSiegeSurrender.Hint" text="启用后，若局势足够危急，被围困的定居点可以提出投降。禁用此项可防止任何围城投降行为。"/>
    <string id="JGUM.Settings.EnableSiegeStarvationSallyOut.Name" text="启用饥饿突围"/>
    <string id="JGUM.Settings.EnableSiegeStarvationSallyOut.Hint" text="启用后，拒绝投降且处于饥饿状态的守军可能会发动绝望的冲锋突围，而不是坐以待毙。"/>
    <string id="JGUM.Settings.NearbyEnemyLordStrengthPercentage.Name" text="附近敌方领主兵力比例 (%)"/>
    <string id="JGUM.Settings.NearbyEnemyLordStrengthPercentage.Hint" text="当敌对领主靠近被围困的定居点时，其兵力的该百分比会提升守军的信心，使其更不易投降。默认值：50"/>
    <string id="JGUM.Settings.NearbyEnemyLordDetectionRange.Name" text="附近领主侦测范围"/>
    <string id="JGUM.Settings.NearbyEnemyLordDetectionRange.Hint" text="定居点在地图上搜寻附近领主的距离。范围越大，纳入投降计算的领主就越多。默认值：7"/>
    <string id="JGUM.Settings.SiegeTowerEnginePressureMultiplier.Name" text="攻城塔压力系数"/>
    <string id="JGUM.Settings.SiegeTowerEnginePressureMultiplier.Hint" text="攻城塔对守军施加的投降压力程度。数值越高，攻城塔的威慑力越强。默认值：70"/>
    <string id="JGUM.Settings.SiegeRamEnginePressureMultiplier.Name" text="撞锤压力系数"/>
    <string id="JGUM.Settings.SiegeRamEnginePressureMultiplier.Hint" text="撞锤对守军施加的投降压力程度。数值越高，撞锤的威慑力越强。默认值：70"/>
    <string id="JGUM.Settings.SiegeCatapultEnginePressureMultiplier.Name" text="投石机压力系数"/>
    <string id="JGUM.Settings.SiegeCatapultEnginePressureMultiplier.Hint" text="投石机对守军施加的投降压力程度。数值越高，越容易迫使守军放弃抵抗。默认值：65"/>
    <string id="JGUM.Settings.SiegeTrebuchetEnginePressureMultiplier.Name" text="配重投石机压力系数"/>
    <string id="JGUM.Settings.SiegeTrebuchetEnginePressureMultiplier.Hint" text="配重投石机对守军施加的投降压力程度。数值越高，越容易迫使守军放弃抵抗。默认值：65"/>
    <string id="JGUM.Settings.SiegeEnginePowerRatioMultiplier.Name" text="攻城器械战力比乘数"/>
    <string id="JGUM.Settings.SiegeEnginePowerRatioMultiplier.Hint" text="己方攻城器械数量超过守军时对劝降压力的影响程度。数值越高，器械优势带来的加成越大。默认值：35"/>
    <string id="JGUM.Settings.SiegeWallDamagePressureMultiplier.Name" text="城墙损伤压力乘数"/>
    <string id="JGUM.Settings.SiegeWallDamagePressureMultiplier.Hint" text="城墙受损对劝降压力的提升程度。残破的城墙会让守军感到暴露无遗，更倾向于投降。默认值：75"/>
    <string id="JGUM.Settings.SiegeWallDestroyedBonus.Name" text="城墙摧毁奖励"/>
    <string id="JGUM.Settings.SiegeWallDestroyedBonus.Hint" text="每段城墙被完全攻破所增加的额外劝降压力。缺口越多，守军投降的压力越大。默认值：0.2"/>
    <string id="JGUM.Settings.SiegeWallDamageCurveExponent.Name" text="城墙损伤曲线指数"/>
    <string id="JGUM.Settings.SiegeWallDamageCurveExponent.Hint" text="控制城墙损伤效果的缩放方式。数值越高，轻微裂痕影响越小，但严重破损会导致劝降压力大幅跃升。默认值：1.5"/>
    <string id="JGUM.Settings.SiegeNegotiationEasyThreshold.Name" text="简易谈判阈值"/>
    <string id="JGUM.Settings.SiegeNegotiationEasyThreshold.Hint" text="说服难度变为“简易”时的战力比。当你的军队实力达到此倍数时，说服守军将变得轻而易举。默认值：3.0"/>
    <string id="JGUM.Settings.SiegeNegotiationNormalThreshold.Name" text="普通谈判阈值"/>
    <string id="JGUM.Settings.SiegeNegotiationNormalThreshold.Hint" text="说服难度为“普通”时的战力比。你拥有明显优势，但仍需有力的说辞。默认值：2.2"/>
    <string id="JGUM.Settings.SiegeNegotiationHardThreshold.Name" text="困难谈判阈值"/>
    <string id="JGUM.Settings.SiegeNegotiationHardThreshold.Hint" text="说服难度为“困难”时的战力比。低于此值时，守军几乎没有谈判的理由。默认值：1.6"/>
    <string id="JGUM.Settings.SiegeNegotiationDifficultyPreset.Name" text="说服难度"/>
    <string id="JGUM.Settings.SiegeNegotiationDifficultyPreset.Hint" text="控制说服守军投降的难度。"/>
    <string id="JGUM.Settings.SiegeNegotiationDifficultyPreset.Easy" text="简易"/>
    <string id="JGUM.Settings.SiegeNegotiationDifficultyPreset.Normal" text="普通"/>
    <string id="JGUM.Settings.SiegeNegotiationDifficultyPreset.Hard" text="困难"/>
    <string id="JGUM.Settings.EnableLordSurrender.Name" text="启用领主投降"/>
    <string id="JGUM.Settings.EnableLordSurrender.Hint" text="启用后，若你实力远超对手，地图上遇到的敌方领主可能会投降。禁用则强制进行战斗。"/>
    <string id="JGUM.Settings.LordDialogPriority.Name" text="领主对话优先级"/>
    <string id="JGUM.Settings.LordDialogPriority.Hint" text="技术选项：领主投降对话的优先级。数值越高，JGUM 越优先于其他模组生效。仅在存在模组冲突时修改。默认值：10000"/>
    <string id="JGUM.Settings.LordCalculatingMultiplier.Name" text="精明特性系数"/>
    <string id="JGUM.Settings.LordCalculatingMultiplier.Hint" text="防守领主的“精明”特性对投降意愿的影响程度。精明的领主更为务实，在处于劣势时更容易投降。默认值：100"/>
    <string id="JGUM.Settings.LordValorMultiplier.Name" text="勇敢特性系数"/>
    <string id="JGUM.Settings.LordValorMultiplier.Hint" text="防守领主的“勇敢”特性对投降意愿的影响程度。勇敢的领主倾向于战斗，不太愿意放弃。默认值：100"/>
    <string id="JGUM.Settings.LordMercyMultiplier.Name" text="仁慈特性系数"/>
    <string id="JGUM.Settings.LordMercyMultiplier.Hint" text="防守领主的“仁慈”特性对投降意愿的影响程度。仁慈的领主倾向于保全性命，更愿意投降。默认值：100"/>
    <string id="JGUM.Settings.LordHonorMultiplier.Name" text="荣誉特性系数"/>
    <string id="JGUM.Settings.LordHonorMultiplier.Hint" text="防守领主的“荣誉”特性对投降意愿的影响程度。重视荣誉的领主视投降为耻辱，会更顽强地抵抗。默认值：100"/>
    <string id="JGUM.Settings.EnablePatrolSurrender.Name" text="启用巡逻队投降"/>
    <string id="JGUM.Settings.EnablePatrolSurrender.Hint" text="启用后，非领主敌方队伍（如巡逻队、商队等）在实力悬殊时可能会投降。禁用则强制进行战斗。"/>
    <string id="JGUM.Settings.PatrolDialogPriority.Name" text="巡逻队对话优先级"/>
    <string id="JGUM.Settings.PatrolDialogPriority.Hint" text="技术选项：巡逻队投降对话的优先级。数值越高，JGUM 越优先于其他模组生效。仅在存在模组冲突时修改。默认值：10000"/>
    <string id="jgum_fief_purchase_inquiry_title" text="商人的提议"/>
    <string id="jgum_fief_purchase_inquiry_body" text="{BESIEGER_NAME} 提出支付 {OFFER_GOLD}{GOLD_ICON} 第纳尔，以换取 {SETTLEMENT_NAME} 的和平投降。该提议附带保证：不进行劫掠，不报复守军。"/>
    <string id="jgum_fief_purchase_accept" text="接受提议"/>
    <string id="jgum_fief_purchase_reject" text="拒绝提议"/>
    <string id="jgum_fief_purchase_accepted_msg" text="定居点已移交。金钱易手，围城战结束，未再发生流血事件。"/>
    <string id="jgum_fief_purchase_rejected_msg" text="你已拒绝该提议。围城战继续。"/>
    <string id="JGUM.Settings.Group.FiefPurchase" text="封地购买提议"/>
    <string id="JGUM.Settings.EnableFiefPurchaseOffer.Name" text="启用封地购买提议"/>
    <string id="JGUM.Settings.EnableFiefPurchaseOffer.Hint" text="启用后，在围城期间，拥有高贸易技能的敌方围攻者可能会提出用金币购买你的定居点。"/>
    <string id="JGUM.Settings.FiefPriceOfferMultiplier.Name" text="报价乘数"/>
    <string id="JGUM.Settings.FiefPriceOfferMultiplier.Hint" text="围攻者出价的金币倍数。数值越高，出价越慷慨。"/>
    <string id="JGUM.Settings.MinTradeSkillForFiefOffer.Name" text="最低贸易技能"/>
